# Anthropic API key, server-side only. Never expose this to the client.
# Required for a plain web deployment. In the packaged Windows (Electron)
# app this can be left blank — enter the key instead in the in-app ⚙ 설정
# screen, which saves it locally on the user's PC.
ANTHROPIC_API_KEY=

# Optional: override the Claude model used for content generation.
# Default if unset: claude-sonnet-5
# Higher-capability alternative: claude-opus-5
CLAUDE_MODEL_ID=

# Optional: Google Gemini API key, used only to generate the main thumbnail
# image from the 메인 썸네일 프롬프트. Get one at aistudio.google.com.
# Same rule as above — can be left blank and entered in the ⚙ 설정 screen instead.
# If unset entirely, the app still shows the thumbnail prompt text, it just
# won't auto-generate an image.
GEMINI_API_KEY=

# Optional: override the Gemini image model.
# Default if unset: gemini-2.5-flash-image
GEMINI_IMAGE_MODEL_ID=

# Optional: shared password protecting a public web deployment (e.g. a link
# shared with a handful of friends). Leave unset for local dev and the
# packaged Windows app — it's a no-op there. When set, every visitor must
# enter this password (any username works) via the browser's login prompt.
APP_ACCESS_PASSWORD=
